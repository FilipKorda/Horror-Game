  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Gameplay_en-GB
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en-GB
  m_SharedData: {fileID: 11400000, guid: 5341a9dbea27804469105c2dc8e7196b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 3181662208
    m_Localized: 'The vampire hunted you through its dark corridors until you finally
      found a way to defeat it by burning its belongings.



      You fled the burning
      house without looking back. You ran until the house vanished into the darkness...
      yet you could still hear its scream behind you.'
    m_Metadata:
      m_Items: []
  - m_Id: 4066199752704
    m_Localized: Find a way to escape from the house.
    m_Metadata:
      m_Items: []
  - m_Id: 4148689129472
    m_Localized: 'Find on this floor:'
    m_Metadata:
      m_Items: []
  - m_Id: 4183908700160
    m_Localized: Belt
    m_Metadata:
      m_Items: []
  - m_Id: 4197527605248
    m_Localized: 'Clothes '
    m_Metadata:
      m_Items: []
  - m_Id: 4219476398080
    m_Localized: Hood
    m_Metadata:
      m_Items: []
  - m_Id: 4235255369728
    m_Localized: Scarf
    m_Metadata:
      m_Items: []
  - m_Id: 4254876323840
    m_Localized: Put them on a pedestal.
    m_Metadata:
      m_Items: []
  - m_Id: 5497833148416
    m_Localized: Lighter
    m_Metadata:
      m_Items: []
  - m_Id: 5548689084416
    m_Localized: Lighter Fluid
    m_Metadata:
      m_Items: []
  - m_Id: 5440190828544
    m_Localized: Go up to the next floor.
    m_Metadata:
      m_Items: []
  - m_Id: 5589243809792
    m_Localized: Return to the pedestal and burn it.
    m_Metadata:
      m_Items: []
  - m_Id: 1063623328026624
    m_Localized: "Your heart couldn't withstand the stress of sheer terror. The vampire
      caught you too often, and you suffered a heart attack.\r\n\r\nHaste isn't always
      the key to achieving your goal. \n\"Haste makes the devil rejoice!\""
    m_Metadata:
      m_Items: []
  - m_Id: 9353507409002496
    m_Localized: Quest Description
    m_Metadata:
      m_Items: []
  - m_Id: 10578238166564864
    m_Localized: You survived the night.
    m_Metadata:
      m_Items: []
  - m_Id: 10578238267228160
    m_Localized: Escape time
    m_Metadata:
      m_Items: []
  - m_Id: 10578238267228161
    m_Localized: Times caught
    m_Metadata:
      m_Items: []
  - m_Id: 10578238267228162
    m_Localized: Medicine used
    m_Metadata:
      m_Items: []
  - m_Id: 10585905400414208
    m_Localized: You were scared to death. Your heart gave out.
    m_Metadata:
      m_Items: []
  - m_Id: 10585905484300288
    m_Localized: Time survived
    m_Metadata:
      m_Items: []
  - m_Id: 10585905484300289
    m_Localized: Fear level
    m_Metadata:
      m_Items: []
  - m_Id: 11562219750064128
    m_Localized: The smoke took your last breath.
    m_Metadata:
      m_Items: []
  - m_Id: 11562219817172992
    m_Localized: 'You set the vampire''s belongings on fire, and the flames swallowed
      the whole house. You searched for a way out through the thick smoke, but every
      breath burned more than the last.


      The fire that was meant to free you
      locked you inside. You never reached the door.'
    m_Metadata:
      m_Items: []
  - m_Id: 11562219817172993
    m_Localized: Fires burning
    m_Metadata:
      m_Items: []
  - m_Id: 11579553562787840
    m_Localized: QUEST {0}/{1}
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285312
    m_Localized: Place the vampire's attire on the pedestal
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285313
    m_Localized: Prepare the fire
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285314
    m_Localized: Escape the burning house!
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285315
    m_Localized: 'On pedestal: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285316
    m_Localized: 'carrying: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285317
    m_Localized: You carry {0}. Take it to the pedestal.
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285318
    m_Localized: Search this floor for the rest ({0} left).
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285319
    m_Localized: The gate is open. Go up to the next floor.
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285320
    m_Localized: Find the lighter.
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285321
    m_Localized: Find more lighter fluid ({0} left).
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285322
    m_Localized: You have everything! Go back and burn the pedestal.
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285323
    m_Localized: Find the way out of the house.
    m_Metadata:
      m_Items: []
  - m_Id: 11579553638285324
    m_Localized: Smoke! Get out before you run out of air!
    m_Metadata:
      m_Items: []
  references:
    version: 2
