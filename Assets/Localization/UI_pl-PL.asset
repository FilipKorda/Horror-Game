  - m_Id: 101428737888256
    m_Localized: Podsumowanie
    m_Metadata:
      m_Items: []
  - m_Id: 101602906361856
    m_Localized: "G\u0142\xF3wne menu"
    m_Metadata:
      m_Items: []
  - m_Id: 102257465249792
    m_Localized: "wzn\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 816685613600768
    m_Localized: "Uciek\u0142e\u015B!"
    m_Metadata:
      m_Items: []
  - m_Id: 1164853886865408
    m_Localized: "Umar\u0142e\u015B!"
    m_Metadata:
      m_Items: []
  - m_Id: 1464816596439040
    m_Localized: "Na Pewno chcesz wyj\u015B\u0107 z gry?"
    m_Metadata:
      m_Items: []
  - m_Id: 1465338372050944
    m_Localized: "Chcesz wr\xF3ci\u0107 do main menu?"
    m_Metadata:
      m_Items: []
  - m_Id: 1465669713678336
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 1465689250746368
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 1503449458167808
    m_Localized: "Czy chcesz przej\u015B\u0107 tutorial?"
    m_Metadata:
      m_Items: []
  - m_Id: 1509831515328512
    m_Localized: Tutaj masz obecne zadanie do wykonania.
    m_Metadata:
      m_Items: []
  - m_Id: 1510189343985664
    m_Localized: "Miernik twojego przere\u017Cenia, je\u017Celi si\u0119 ca\u0142y
      wype\u0142ni to umrzesz."
    m_Metadata:
      m_Items: []
  - m_Id: 1510794456223744
    m_Localized: "Ilo\u015B\u0107 posiadanych baterii oraz aktualny stan baterii."
    m_Metadata:
      m_Items: []
  - m_Id: 1511034349441024
    m_Localized: "Ilo\u015B\u0107 posiadanych lek\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 1511349433946112
    m_Localized: "Tutaj regulujesz zasi\u0119gu i jasno\u015Bci latarki."
    m_Metadata:
      m_Items: []
  - m_Id: 1531363134296064
    m_Localized: "aby podnie\u015B\u0107 lub po\u0142o\u017Cy\u0107 przedmioty."
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1531369123762176
    m_Localized: "aby prze\u0142adowa\u0107 bateri\u0119."
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1531388484669440
    m_Localized: "by u\u017Cy\u0107 lek\xF3w."
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1531402464284672
    m_Localized: "aby w\u0142\u0105czy\u0107 lub wy\u0142\u0105czy\u0107 latark\u0119."
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1531436941463552
    m_Localized: "aby wyregulowa\u0107 latark\u0119."
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1531452691075072
    m_Localized: "aby i\u015B\u0107 powoli."
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1531466867822592
    m_Localized: aby biec.
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
  - m_Id: 1623418753798144
    m_Localized: Zmniejsz rozmiar latarki
    m_Metadata:
      m_Items:
      - rid: 5759769032457977963
